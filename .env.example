# compose.yaml의 로컬 시연 기본값을 바꾸려면 이 파일을 .env로 복사한다. .env는 커밋하지 않는다.
# 앱의 DB 주소에 그대로 들어간다: 영문·숫자와 - _ . ~만 쓴다('@'나 '%'가 들어가면 주소가 깨진다).
POSTGRES_PASSWORD=
ADMIN_TOKEN=
MODEL=qwen3.5:4b
# on, off, omit(보내지 않음). 비워 두면 qwen3.5:4b에는 off, 다른 모델에는 omit.
THINK=
OLLAMA_URL=http://host.docker.internal:11434
APPROVAL_REFUND_WON=100000
# 요청 뒤 Ollama가 모델을 메모리(GPU)에 두는 시간(Ollama의 keep_alive 형식: 60m, 24h, 초 단위 정수 3600,
# 음수 -1은 내리지 않음, 0은 답한 뒤 바로 내림). PRELOAD=1이면 앱이 시작할 때 모델을 한 번 미리 올린다.
# 기본값(60m, 0)은 고객이 없을 때 GPU를 다른 작업에 비워 두는 대신, 띄운 직후와 오래 쉰 뒤의 첫 메시지가
# 모델을 올리는 시간만큼 늦다.
KEEP_ALIVE=60m
PRELOAD=0
APP_PORT=8062
DB_PORT=55462
# 음성 모드는 compose에 없다(이미지에 음성 모델이 없다): 호스트에서 띄운다(docs/voice.md).
# 그 설정은 거기서 SUPPORT_AGENT_* 변수로 준다. 예: SUPPORT_AGENT_MAX_CONCURRENT_SPEECH=2
# (동시에 읽어 주는 답의 수. 넘는 요청은 429를 받고 2초 뒤 다시 시도한다).
