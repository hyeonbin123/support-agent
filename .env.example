# Copy to .env to change the local demo defaults of compose.yaml. Never commit .env.
# Goes into the app's database URL as is: use letters, digits and - _ . ~ ('@' or '%' breaks it).
POSTGRES_PASSWORD=
ADMIN_TOKEN=
MODEL=qwen3.5:4b
# on, off or omit (not sent). Empty: off for qwen3.5:4b, omit for other models.
THINK=
OLLAMA_URL=http://host.docker.internal:11434
APPROVAL_REFUND_WON=100000
APP_PORT=8062
DB_PORT=55462
